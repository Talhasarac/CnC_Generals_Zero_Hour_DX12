+	// On a Windows 11 25H2 / GeForce RTX 4060 Ti machine 9On12 renders every frame correctly
+	// but its windowed present shows nothing (the window keeps its GDI background) once the
+	// back buffer is larger than about 640x480 - found by bisection with dx8_smoke -show:
+	// 640x481, 800x480, 640x600, 1024x240 are fine, 800x600 and up are blank, regardless of
+	// window style, swap effect, back buffer count or present interval; fullscreen is fine.
+	// So a windowed device is created from a plain Direct3D 9 object instead (the caps the
+	// app already queried came from 9On12, same adapter - close enough for a Direct3D 8 app).
+	IDirect3D9 *CreateFrom = ProxyInterface;
+	if (PresentParams.Windowed && GetModuleHandle(TEXT("d3d9on12.dll")) != nullptr)
+	{
+		static IDirect3D9 *PlainD3D9 = nullptr;	// kept for the process lifetime, like the 9On12 one
+		if (PlainD3D9 == nullptr)
+			PlainD3D9 = Direct3DCreate9(D3D_SDK_VERSION);
+		if (PlainD3D9 != nullptr)
+			CreateFrom = PlainD3D9;
+		std::ofstream d3d12Log("d3d8to9_d3d12.log", std::ios::app);
+		if (d3d12Log.is_open())
+			d3d12Log << "CreateDevice: windowed -> " << (CreateFrom == PlainD3D9 ? "plain Direct3D 9 (9On12 windowed present is blank above ~640x480)" : "9On12 (Direct3DCreate9 failed)") << std::endl;
+	}
+
+	const HRESULT hr = CreateFrom->CreateDevice(Adapter, DeviceType, hFocusWindow, BehaviorFlags, &PresentParams, &DeviceInterface);
 	if (FAILED(hr))
 		return hr;
 
